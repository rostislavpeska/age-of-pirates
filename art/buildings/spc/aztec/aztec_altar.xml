<animfile>
    <definebone>bone_aztec</definebone>
    <definebone>bone_inner_circle</definebone>
    <definebone>bone_outer_circle</definebone>
    <attachment>fire_pile
        <component>signal_fire
            <assetreference type="GrannyModel">
                <file>buildings\native_civs\dance_pit\logpile</file>
            </assetreference>
        </component>
        <anim>Idle
            <component>signal_fire</component>
        </anim>
    </attachment>
    <attachment>flagpole
        <component>flagpole
            <assetreference type="GrannyModel">
                <file>buildings\native_civs\dance_pit\dance_flagpole</file>
            </assetreference>
        </component>
        <anim>Idle
            <component>flagpole</component>
        </anim>
    </attachment>
    <attachment>rock_circle
        <component>rock_circle
            <assetreference type="GrannyModel">
                <file>buildings\native_civs\dance_pit\iro_rock_circle</file>
            </assetreference>
        </component>
        <anim>Idle
            <component>rock_circle</component>
        </anim>
    </attachment>
    <attachment>spirit_poles_iro
        <component>poles01
            <assetreference type="GrannyModel">
                <file>buildings\native_civs\dance_pit\iro_spirit_poles</file>
            </assetreference>
        </component>
        <anim>Idle
            <component>poles01</component>
        </anim>
    </attachment>
    <submodel>Aztec_fire_pit
        <attachment>aztec_fire_pile
            <component>aztec_fires
                <logic type="Destruction">
                    <p1>
                        <assetreference type="GrannyModel">
                            <file>buildings\spc\aztec\firepit\aztec_altar_damaged</file>
                        </assetreference>
                    </p1>
                    <p99>
                        <assetreference type="GrannyModel">
                            <file>buildings\spc\aztec\firepit\aztec_altar</file>
                        </assetreference>
                    </p99>
                </logic>
            </component>
            <anim>Idle
                <component>aztec_fires</component>
            </anim>
        </attachment>
        <attachment>myfire
            <component>emitter
                <assetreference type="popcornfx">
                    <file>fire\pitfire_small_red.pkfx</file>
                </assetreference>
            </component>
            <anim>None
                <component>emitter</component>
            </anim>
        </attachment>
        <attachment>collapse_smoke
            <component>collapse_smoke
                <assetreference type="popcornFx">
                    <file>smoke\collapse_smoke_3x3.pkfx</file>
                </assetreference>
            </component>
            <anim>Idle
                <component>collapse_smoke</component>
            </anim>
        </attachment>
        <component>LIVE
            <logic type="LowPoly">
                <normal>
                    <logic type="Destruction">
                        <p1>
                            <assetreference type="GrannyModel" shape="wall_wood_corner">
                                <file>buildings\native_civs\dance_pit\dance_circles</file>
                            </assetreference>
                            <attach a="aztec_fire_pile" frombone="ATTACHPOINT" tobone="ATTACHPOINT" syncanims="0"></attach>
                        </p1>
                        <p99>
                            <assetreference type="GrannyModel" shape="wall_wood_corner">
                                <file>buildings\native_civs\dance_pit\dance_circles</file>
                            </assetreference>
                            <attach a="aztec_fire_pile" frombone="ATTACHPOINT" tobone="ATTACHPOINT" syncanims="0"></attach>
                        </p99>
                    </logic>
                </normal>
                <lowpoly>
                    <assetreference type="GrannyModel" shape="wall_wood_corner">
                        <file>buildings\native_civs\dance_pit\dance_circles</file>
                    </assetreference>
                    <attach a="aztec_fire_pile" frombone="ATTACHPOINT" tobone="ATTACHPOINT" syncanims="0"></attach>
                </lowpoly>
            </logic>
            <decal>
                <effecttype>bump</effecttype>
                <texture>buildings\spc\aztec\firepit\dance_pit_ground_large_aztec_basecolor</texture>
                <selectedtexture>shadows_selections\selection_square_128x128</selectedtexture>
                <width>16.00</width>
                <height>16.00</height>
            </decal>
            <attach a="myfire" frombone="ATTACHPOINT" tobone="bone_aztec" syncanims="0"></attach>
        </component>
        <component>DEAD
            <logic type="LowPoly">
                <normal>
                    <assetreference type="GrannyModel">
                        <file>buildings\native_civs\dance_pit\aztec_altar_deathmodel</file>
                    </assetreference>
                </normal>
                <lowpoly>
                    <assetreference type="GrannyModel">
                        <file>buildings\native_civs\dance_pit\lp_aztec_altar</file>
                    </assetreference>
                </lowpoly>
            </logic>
            <decal>
                <effecttype>bump</effecttype>
                <texture>buildings\spc\aztec\firepit\dance_pit_ground_large_aztec_basecolor</texture>
                <selectedtexture>shadows_selections\selection_square_128x128</selectedtexture>
                <width>16.00</width>
                <height>16.00</height>
            </decal>
        </component>
        <anim>Idle
            <component>LIVE</component>
        </anim>
        <anim>Death
            <assetreference type="GrannyAnim">
                <file>buildings\native_civs\dance_pit\aztec_altar_deathanim</file>
            </assetreference>
            <component>DEAD</component>
            <attach a="collapse_smoke" frombone="ATTACHPOINT" tobone="ATTACHPOINT" syncanims="0"></attach>
        </anim>
    </submodel>
    <submodel>Aztec_sub_construction_stage_01
        <component>aztec_construction_stage_01
            <assetreference type="GrannyModel">
                <file>buildings\spc\aztec\firepit\aztec_dance_pit_stage1</file>
            </assetreference>
            <decal>
                <effecttype>bump</effecttype>
                <texture>buildings\spc\aztec\firepit\dance_pit_ground_large_aztec_basecolor</texture>
                <selectedtexture>shadows_selections\selection_square_128x128</selectedtexture>
                <width>16.00</width>
                <height>16.00</height>
            </decal>
        </component>
        <anim>Idle
            <component>aztec_construction_stage_01</component>
        </anim>
    </submodel>
    <submodel>Aztec_sub_construction_stage_02
        <component>aztec_construction_stage_02
            <assetreference type="GrannyModel">
                <file>buildings\spc\aztec\firepit\aztec_dance_pit_stage2</file>
            </assetreference>
            <decal>
                <effecttype>bump</effecttype>
                <texture>buildings\spc\aztec\firepit\dance_pit_ground_large_aztec</texture>
                <selectedtexture>shadows_selections\selection_square_128x128</selectedtexture>
                <bumptexture>buildings\spc\aztec\firepit\dance_pit_ground_large_aztec_b</bumptexture>
                <width>16.00</width>
                <height>16.00</height>
            </decal>
        </component>
        <anim>Idle
            <component>aztec_construction_stage_02</component>
        </anim>
    </submodel>
    <submodel>Aztec_sub_construction_stage_03
        <component>aztec_construction_stage_03
            <assetreference type="GrannyModel">
                <file>buildings\spc\aztec\firepit\aztec_dance_pit_stage3</file>
            </assetreference>
            <decal>
                <effecttype>bump</effecttype>
                <texture>buildings\spc\aztec\firepit\dance_pit_ground_large_aztec_basecolor</texture>
                <selectedtexture>shadows_selections\selection_square_128x128</selectedtexture>
                <width>16.00</width>
                <height>16.00</height>
            </decal>
        </component>
        <anim>Idle
            <component>aztec_construction_stage_03</component>
        </anim>
    </submodel>
    <component>ModelComp
        <logic type="BuildingCompletion">
            <p0>
                <submodelref ref="Aztec_sub_construction_stage_01"></submodelref>
            </p0>
            <p33>
                <submodelref ref="Aztec_sub_construction_stage_02"></submodelref>
            </p33>
            <p66>
                <submodelref ref="Aztec_sub_construction_stage_03"></submodelref>
            </p66>
            <p100>
                <submodelref ref="Aztec_fire_pit"></submodelref>
            </p100>
        </logic>
    </component>
    <anim>idle
        <component>ModelComp</component>
    </anim>
</animfile>
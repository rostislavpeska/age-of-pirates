<animfile>
    <definebone>bone_main</definebone>
    <definebone>bone_master</definebone>
    <definebone>bone_smoke</definebone>  
    <definebone>bone_debris_part_001</definebone>
    <definebone>bone_debris_part_002</definebone>
    <definebone>bone_debris_part_003</definebone>
    <definebone>bone_debris_part_004</definebone>
    <definebone>bone_debris_part_005</definebone>
    <definebone>bone_debris_part_006</definebone>
    <definebone>bone_debris_part_007</definebone>
    <definebone>bone_debris_part_008</definebone>
    <definebone>bone_debris_part_009</definebone>
    <submodel>
        dry dock
        <attachment>
            collapse_smoke
            <component>
                collapse_smoke<assetreference type="popcornFx"><file>smoke\collapse_smoke_4x4.pkfx</file></assetreference>
            </component>
            <anim>Idle<component>collapse_smoke</component></anim>
        </attachment>
        <attachment>
            chimney_smoke
            <component>smoke_part
                <assetreference type="ParticleSystem">
                    <file>effects\smoke\white_smoke_a.particle</file>
                </assetreference>
            </component>    
            <anim>Idle
                <component>smoke_part</component>
            </anim>
        </attachment>
        <component>
            dry dock
            <logic type="Destruction">
                <p1>
                    <assetreference type="GrannyModel">
                        <file>buildings\spc\aztec\montezuma_palace_Damaged</file>
                    </assetreference>
                </p1>
                <p99>
                    <assetreference type="GrannyModel">
                        <file>buildings\spc\aztec\montezuma_palace_Model</file>
                    </assetreference>
                </p99>
            </logic>
            <decal>
                <effecttype>default</effecttype><selectedtexture>shadows_selections\selection_square_128x128</selectedtexture>
                <width>22</width><height>22</height>
            </decal>
            <attach a="chimney_smoke" frombone="ATTACHPOINT" tobone="bone_smoke" syncanims="0"></attach>
        </component>
        <component>
            DEAD
            <assetreference type="GrannyModel">
                <file>buildings\spc\aztec\montezuma_palace_Deathmodel</file>
            </assetreference>
        </component>
        <anim>RangedAttack
            <assetreference type="GrannyAnim">
                <file>buildings\spc\aztec\montezuma_palace_Anim</file>
                <tag type="Attack">0.45</tag>
                <tag type="Attack">0.44</tag>
                <tag type="Attack">0.43</tag>
                <tag type="Attack">0.42</tag>
                <tag type="Attack">0.41</tag>
                <tag type="Attack">0.40</tag>
                <tag type="Attack">0.43</tag>
                <tag type="Attack">0.42</tag>
                <tag type="SpecificSoundSet" checkvisible="1" set="Arrows">0.45</tag>
                <tag type="SpecificSoundSet" checkvisible="1" set="Arrows">0.44</tag>
                <tag type="SpecificSoundSet" checkvisible="1" set="Arrows">0.43</tag>
                <tag type="SpecificSoundSet" checkvisible="1" set="Arrows">0.42</tag>
                <tag type="SpecificSoundSet" checkvisible="1" set="Arrows">0.41</tag>
                <tag type="SpecificSoundSet" checkvisible="1" set="Arrows">0.43</tag>
                <tag type="SpecificSoundSet" checkvisible="1" set="Arrows">0.42</tag>
                <tag type="SpecificSoundSet" checkvisible="1" set="Arrows">0.40</tag>
            </assetreference>
            <simskeleton>
                <model>buildings\spc\aztec\montezuma_palace_Damaged</model>
                <damagetemplate>buildings\spc\aztec\montezuma_palace_Damaged.dmg</damagetemplate>
            </simskeleton>
            <component>dry dock</component>
        </anim>
        <anim>
            Idle
            <assetreference type="GrannyAnim">
                <file>buildings\spc\aztec\montezuma_palace_Anim</file>
            </assetreference>
            <component>dry dock</component>
            <simskeleton>
                <model>buildings\spc\aztec\montezuma_palace_Damaged</model>
                <damagetemplate>buildings\spc\aztec\montezuma_palace_Damaged.dmg</damagetemplate>
            </simskeleton>
        </anim>
        <anim>
            Death
            <assetreference type="GrannyAnim">
                <file>buildings\spc\aztec\montezuma_palace_Deathanim</file>
            </assetreference>
            <component>DEAD</component>
            <attach a="collapse_smoke" frombone="ATTACHPOINT" tobone="ATTACHPOINT" syncanims="0"></attach>
        </anim>
    </submodel>
    <submodel>
        con 1
        <component>
            con 1
            <assetreference type="GrannyModel">
                <file>buildings\constructions\drydock_con_stage1_Model</file>
            </assetreference>
            <decal>
                <effecttype>default</effecttype>
                <selectedtexture>shadows_selections\selection_square_128x128</selectedtexture>
                <width>22</width><height>22</height>
            </decal>
        </component>
        <anim>idle
            <component>con 1</component>
        </anim>
    </submodel>
    <submodel>
        con 2
        <component>
            con 2
            <assetreference type="GrannyModel">
                <file>buildings\constructions\drydock_con_stage2_Model</file>
            </assetreference>
            <decal>
                <effecttype>default</effecttype>
                <selectedtexture>shadows_selections\selection_square_128x128</selectedtexture>
                <width>22</width><height>22</height>
            </decal>
        </component>
        <anim>idle
            <component>con 2</component>
        </anim>
    </submodel>
    <submodel>
        con 3
        <attachment>
            dock
            <component>
                dock
                <assetreference type="GrannyModel">
                    <file>buildings\spc\dry_dock\dry_dock_con_Model</file>
                </assetreference>
            </component>
            <anim>Idle<component>dock</component></anim>
        </attachment>
        <component>
            con 3
            <assetreference type="GrannyModel">
                <file>buildings\constructions\drydock_con_stage3_Model</file>
            </assetreference>
            <decal>
                <effecttype>default</effecttype>
                <selectedtexture>shadows_selections\selection_square_128x128</selectedtexture>
                <width>22</width><height>22</height>
            </decal>
            <attach a="dock" frombone="ATTACHPOINT" tobone="ATTACHPOINT" syncanims="0"></attach>
        </component>
        <anim>idle
            <component>con 3</component>
        </anim>
    </submodel>

    <component>
        ModelComp
        <logic type="BuildingCompletion">
            <p0><submodelref ref="con 1"></submodelref></p0>
            <p33><submodelref ref="con 2"></submodelref></p33>
            <p66><submodelref ref="con 3"></submodelref></p66>
            <p100><submodelref ref="dry dock"></submodelref></p100>
        </logic>
    </component>
</animfile>
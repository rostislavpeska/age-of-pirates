<animfile>
  <submodel>construction stage1
    <component>construction
      <assetreference type="GrannyModel">
        <file>buildings\constructions\3x3_stage1</file>
      </assetreference>
    </component>
    <anim>Idle
      <component>construction</component>
    </anim>
  </submodel>
  <submodel>construction stage2
    <component>construction
      <assetreference type="GrannyModel">
        <file>buildings\constructions\3x3_stage2</file>
      </assetreference>
    </component>
    <anim>Idle
      <component>construction</component>
    </anim>
  </submodel>
  <submodel>construction stage3
    <attachment>scaffolding
      <component>construction3
        <assetreference type="GrannyModel">
          <file>buildings\constructions\3x3_stage3</file>
        </assetreference>
      </component>
      <anim>Idle
        <component>construction3</component>
      </anim>
    </attachment>
    <component>saloon_construction
      <assetreference type="GrannyModel">
        <file>buildings\sheriff\sheriff_con</file>
      </assetreference>
      <attach a="scaffolding" frombone="ATTACHPOINT" tobone="ATTACHPOINT" syncanims="0"></attach>
    </component>
    <anim>Idle
      <component>saloon_construction</component>
    </anim>
  </submodel>
  <submodel>test_cube
    <attachment>collapse_smoke
      <component>collapse_smoke
        <assetreference type="popcornFx">
          <file>smoke\collapse_smoke_3x3.pkfx</file>
        </assetreference>
      </component>
      <anim>Idle
        <component>collapse_smoke</component>
      </anim>
    </attachment>
    <component>LIVE
      <logic type="LowPoly">
        <normal>
          <logic type="Destruction">
            <p1>
              <assetreference type="GrannyModel">
                <file>buildings\test_cube\test_cube_damaged</file>
              </assetreference>
            </p1>
            <p99>
              <assetreference type="GrannyModel" shape="saloon">
                <file>buildings\test_cube\test_cube</file>
              </assetreference>
            </p99>
          </logic>
        </normal>
        <lowpoly>
          <assetreference type="GrannyModel" shape="saloon">
            <file>buildings\test_cube\test_cube</file>
          </assetreference>
        </lowpoly>
      </logic>
    </component>
    <component>DEAD
      <logic type="LowPoly">
        <normal>
          <assetreference type="GrannyModel">
            <file>buildings\test_cube\test_cube_damaged</file>
          </assetreference>
        </normal>
        <lowpoly>
          <assetreference type="GrannyModel">
            <file>buildings\test_cube\test_cube</file>
          </assetreference>
        </lowpoly>
      </logic>
    </component>
    <anim>Idle
      <component>LIVE</component>
      <simskeleton>
        <model>buildings\test_cube\test_cube_damaged</model>
      </simskeleton>
    </anim>
    <anim>Death
      <component>DEAD</component>
      <attach a="collapse_smoke" frombone="ATTACHPOINT" tobone="ATTACHPOINT" syncanims="0"></attach>
    </anim>
  </submodel>
  <component>saloon model
    <logic type="BuildingCompletion">
      <p0>
        <submodelref ref="construction stage1"></submodelref>
      </p0>
      <p33>
        <submodelref ref="construction stage2"></submodelref>
      </p33>
      <p66>
        <submodelref ref="construction stage3"></submodelref>
      </p66>
      <p100>
        <submodelref ref="test_cube"></submodelref>
      </p100>
    </logic>
  </component>
</animfile>
<material>
  <!--Korean TC damaged model (S18k UVs on the v20 destruction pieces). mata/matb/matc = the intact pages,
      matz = vanilla destruction sheet on cut faces. Shaders as vanilla damaged materials: destructible on the main
      page and the cut faces, cutout on the alpha page.-->
  <submaterial name="mata">
    <materialdef name="destructible" />
    <parameters>
      <texture name="BaseColor" override="buildings\korean_tc\textures\korean_tc_mata_BaseColor" />
      <texture name="Normals" override="buildings\korean_tc\textures\korean_tc_mata_Normals" />
      <texture name="Masks" override="buildings\korean_tc\textures\korean_tc_mata_Masks" />
      <texture name="Details" override="buildings\korean_tc\textures\korean_tc_mata_Details" />
    </parameters>
  </submaterial>
  <submaterial name="matb">
    <materialdef name="default_cutout" />
    <parameters>
      <texture name="BaseColor" override="buildings\korean_tc\textures\korean_tc_matb_BaseColor" />
      <texture name="Normals" override="buildings\korean_tc\textures\korean_tc_matb_Normals" />
      <texture name="Masks" override="buildings\korean_tc\textures\korean_tc_matb_Masks" />
    </parameters>
  </submaterial>
  <submaterial name="matc">
    <materialdef name="default" />
    <parameters>
      <texture name="BaseColor" override="buildings\korean_tc\textures\korean_tc_matc_BaseColor" />
      <texture name="Normals" override="buildings\korean_tc\textures\korean_tc_matc_Normals" />
      <texture name="Masks" override="buildings\korean_tc\textures\korean_tc_matc_Masks" />
    </parameters>
  </submaterial>
  <submaterial name="matz">
    <materialdef name="destructible" />
    <parameters>
      <texture name="BaseColor" override="generic_props\destruction\textures\destructionsheet_mata_basecolor" />
      <texture name="Normals" override="generic_props\destruction\textures\destructionsheet_mata_normals" />
      <texture name="Masks" override="generic_props\destruction\textures\destructionsheet_mata_masks" />
    </parameters>
  </submaterial>
</material>

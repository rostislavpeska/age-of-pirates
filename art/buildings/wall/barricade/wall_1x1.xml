<animfile>
    <definebone>bone_falling_building</definebone>
    <submodel>wood
        <attachment>collapse_smoke
            <component>collapse_smoke
                <assetreference type="popcornFx">
                    <file>smoke\collapse_smoke_wall1x1.pkfx</file>
                </assetreference>
            </component>
            <anim>Idle
                <component>collapse_smoke</component>
            </anim>
        </attachment>
        <attachment>
            dock
            <component>
                dock
                <assetreference type="GrannyModel">
                    <file>buildings\native_settlement\wall_wood_b</file>
                </assetreference>
            </component>
            <anim>Idle<component>dock</component></anim>
        </attachment>
        <component>woodWall
            <logic type="BuildingCompletion">
                <p0>
                    <assetreference type="GrannyModel">
                        <file>buildings\props_colony\box_a</file>
                    </assetreference>
                    <attach a="props" frombone="ATTACHPOINT" tobone="ATTACHPOINT" syncanims="0"></attach>
                    <decal>
                        <effecttype>bump</effecttype>
                        <texture>buildings\wall\wall_wood_redoubt_ground_small</texture>
                        <selectedtexture>shadows_selections\selection_square_64x128</selectedtexture>
                        <bumptexture>shadows_selections\flat_normal_black_spec</bumptexture>
                        <width>3.50</width>
                        <height>2.50</height>
                    </decal>
                </p0>
			    <p100>
                    <assetreference type="GrannyModel">
                        <file>buildings\native_settlement\wall_wood_b</file>
                    </assetreference>
                    <attach a="props" frombone="ATTACHPOINT" tobone="ATTACHPOINT" syncanims="0"></attach>
                    <decal>
                        <effecttype>bump</effecttype>
                        <texture>buildings\wall\wall_wood_redoubt_ground_small</texture>
                        <selectedtexture>shadows_selections\selection_square_64x128</selectedtexture>
                        <bumptexture>shadows_selections\flat_normal_black_spec</bumptexture>
                        <width>3.50</width>
                        <height>2.50</height>
                    </decal>
                </p100>
            </logic>
        </component>
        <component>woodWall_death
            <assetreference type="GrannyModel">
                <file>buildings\1death_anim\Deathmodel</file>
            </assetreference>
            <attach a="dock" frombone="MASTER" tobone="bone_falling_building" syncanims="0"></attach>
            <decal>
                <effecttype>bump</effecttype>
                <texture>buildings\wall\wall_wood_redoubt_ground_small</texture>
                <selectedtexture>shadows_selections\selection_square_64x128</selectedtexture>
                <bumptexture>shadows_selections\flat_normal_black_spec</bumptexture>
                <width>3.50</width>
                <height>2.50</height>
            </decal>
        </component>
        <anim>Idle
            <component>woodWall</component>
            <simskeleton>
                <model>buildings\wall\wall_wooden_1X1_damaged</model>
            </simskeleton>
        </anim>
        <anim>Death
            <assetreference type="GrannyAnim">
                <file>buildings\1death_anim\Deathmodel_Animation</file>
            </assetreference>
            <component>woodWall_death</component>
            <attach a="collapse_smoke" frombone="ATTACHPOINT" tobone="ATTACHPOINT" syncanims="0"></attach>
        </anim>
    </submodel>
    <component>wall
        <submodelref ref="wood"></submodelref>
    </component>
</animfile>
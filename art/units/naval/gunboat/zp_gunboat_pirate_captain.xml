<animfile>
  <!-- Age of Pirates zpPirateGunboat captain: vanilla gunboat_captain.xml on a vanilla pirate (pirate_3a) wearing
       the explorer tricorne - the hat and attach shape come from units/spc/pirates/pirates.xml. -->
  <definebone>bone_hat</definebone>
  <definebone>Bip01 Prop2</definebone>
  <definebone>Bip01 Prop1</definebone>
  <attachment>hat<component>hat<assetreference type="GrannyModel">
        <file>units\explorers\b_explorer_hat</file>
      </assetreference>
    </component>
    <anim>Idle<component>hat</component>
    </anim>
  </attachment>
  <component>ModelComp<assetreference type="GrannyModel">
      <file>units\spc\pirates\pirate_3a</file>
    </assetreference>
    <attach a="hat" frombone="bone_hat" tobone="HEAD" syncanims="0" />
  </component>
  <anim>Idle<assetreference type="GrannyAnim">
      <file>nuggets\outlaw_kidnap\kidnap_outlawa_idlea</file>
    </assetreference>
    <component>ModelComp</component>
  </anim>
  <anim>Walk<assetreference type="GrannyAnim">
      <file>units\naval\gunboat\gunboat_captain_walk</file>
    </assetreference>
    <component>ModelComp</component>
  </anim>
  <anim>Death<assetreference type="GrannyAnim">
      <file>units\naval\gunboat\gunboat_rowers_death</file>
    </assetreference>
    <component>ModelComp</component>
  </anim>
  <anim>RangedAttack<assetreference type="GrannyAnim">
      <file>units\naval\gunboat\gunboat_captain_attack</file>
      <component>ModelComp</component>
    </assetreference>
  </anim>
  <anim>Bombard_ranged_attack<assetreference type="GrannyAnim">
      <file>nuggets\outlaw_kidnap\kidnap_outlawa_idlea</file>
    </assetreference>
    <component>ModelComp</component>
  </anim>
  <anim>GatherFish<assetreference type="GrannyAnim">
      <file>nuggets\outlaw_kidnap\kidnap_outlawa_idlea</file>
    </assetreference>
    <component>ModelComp</component>
  </anim>
</animfile>

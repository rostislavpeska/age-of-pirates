// 000_unitbench_gaia - unit visual test bench. GENERATED by scripts/tools/unitbench.py - do not edit by hand.
// Player 0 starts at the map centre; two units stand 24.0 m away on the x axis:
//   control unit House (east, +x)   unit under test zpSPCLondonBasilica (west, -x)
// The spine (includes, chooseMercs, rmSetMapSize, rmTerrainInitialize, rmSetMapType, player placement, TC)
// is copied from scripts/maps/000_hkt_test.xs (commit 7130e597) and is mandatory: without it generation
// crashes (0xC0000005 +0x7E9D2D) and without chooseMercs() it aborts (+0xA7508D).

include "mercenaries.xs";
include "ypAsianInclude.xs";
include "ypKOTHInclude.xs";

void main(void)
{
   rmSetStatusText("", 0.01);
   rmSetMapSize(200, 200);
   rmSetMapElevationHeightBlend(1);
   rmSetSeaLevel(0.0);
   rmSetLightingSet("sonora_skirmish");
   rmSetMapElevationParameters(cElevTurbulence, 0.02, 2, 0.5, 1.0);
   rmSetBaseTerrainMix("africa desert rock");
   rmTerrainInitialize("deccan\ground_grass3_deccan", 1.0);
   rmSetMapType("arabia");
   rmSetMapType("desert");
   chooseMercs();
   rmSetWorldCircleConstraint(true);
   rmDefineClass("player");
   rmSetStatusText("", 0.30);

   // players: a small ring so player 1 (the human) is near the centre and the camera opens on it
   rmSetPlacementSection(0.0, 1.0);
   rmPlacePlayersCircular(0.12, 0.12, 0.0);
   rmSetStatusText("", 0.50);

   int tcID = rmCreateObjectDef("player TC");
   rmAddObjectDefItem(tcID, "TownCenter", 1, 0.0);
   rmSetObjectDefMinDistance(tcID, 0.0);
   rmSetObjectDefMaxDistance(tcID, 0.0);
   for(i=1; <= cNumberNonGaiaPlayers)
   {
      rmPlaceObjectDefAtLoc(tcID, i, rmPlayerLocXFraction(i), rmPlayerLocZFraction(i));
   }

   // the bench: control (vanilla, known to render) and subject, player 0, fixed positions
   int benchControlID = rmCreateObjectDef("bench control");
   rmAddObjectDefItem(benchControlID, "House", 1, 0.0);
   rmSetObjectDefMinDistance(benchControlID, 0.0);
   rmSetObjectDefMaxDistance(benchControlID, 0.0);
   int benchSubjectID = rmCreateObjectDef("bench subject");
   rmAddObjectDefItem(benchSubjectID, "zpSPCLondonBasilica", 1, 0.0);
   rmSetObjectDefMinDistance(benchSubjectID, 0.0);
   rmSetObjectDefMaxDistance(benchSubjectID, 0.0);
   float px = rmPlayerLocXFraction(1);
   float pz = rmPlayerLocZFraction(1);
   float dx = rmXMetersToFraction(24.0);
   rmPlaceObjectDefAtLoc(benchControlID, 0, px + dx, pz);
   rmPlaceObjectDefAtLoc(benchSubjectID, 0, px - dx, pz);

   rmSetStatusText("", 1.0);
}

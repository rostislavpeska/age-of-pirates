<mix>
  <title>Italy Dirt Forest</title>
  <icon>terrain\mix\jimmy</icon>
  <paint mode="turbulence" freq="0.1" octaves="6" persistence="0.58">
    <texture weight="1">texas\groundforestdirt_tex</texture>
    <texture weight="2">texas\groundforest_tex</texture>
  </paint>
  <objects mode="turbulence" freq="0.35" octaves="5" persistence="0.6" emptyweight="55" posoffset="0.5">
    <model weight="1">terrain\underbrush\underbrush_desert_rock4</model>
    <model weight="1">terrain\underbrush\underbrush_desert_rock2</model>
    <model weight="1">terrain\underbrush\underbrush_desert_bush3</model>
    <model weight="1">terrain\underbrush\underbrush_desert_bush4</model>
    <model weight="1" scalemin="0.6" scalemax="0.8">terrain\underbrush\underbrush_desert_tallgrass1</model>
    <model weight="1" scalemin="0.8" scalemax="1">terrain\underbrush\underbrush_desert_tallgrass2</model>
    <model weight="2" scalemin="0.6" scalemax="1">terrain\underbrush\underbrush_desert_grass1</model>
    <model weight="2" scalemin="0.6" scalemax="1">terrain\underbrush\underbrush_desert_grass2</model>
    <model weight="1">terrain\underbrush\underbrush_forest_group4</model>
    <model weight="1">terrain\underbrush\underbrush_forest_rock1</model>
  </objects>
</mix>
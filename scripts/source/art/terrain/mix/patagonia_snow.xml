    <model weight="1">terrain\patagonia\underbrush_brush_b_snow_pat</model>
    <model weight="1">terrain\patagonia\underbrush_brush_c_snow_pat</model>
    <model weight="2">terrain\patagonia\underbrush_rock_a_snow_pat</model>
    <model weight="3">terrain\patagonia\underbrush_rock_b_snow_pat</model>
    <model weight="1">terrain\patagonia\underbrush_rock_c_snow_pat</model>
    <model weight="2">terrain\patagonia\underbrush_rock_d_snow_pat</model>
    <model weight="1">terrain\patagonia\underbrush_rock_e_snow_pat</model>
    <model weight="2">terrain\patagonia\underbrush_group_a_snow_pat</model>
    <model weight="2">terrain\patagonia\underbrush_group_b_snow_pat</model>
    <model weight="2">terrain\patagonia\underbrush_group_c_snow_pat</model>
  </objects>
</mix>
<mix>
  <title>Patagonia Snow</title>
  <icon>terrain\mix\jimmy</icon>
  <paint mode="turbulence" freq="0.05" octaves="2" persistence="0.5">
    <texture weight="1">patagonia\ground_snow1_pat</texture>
    <texture weight="2">patagonia\ground_snow2_pat</texture>
    <texture weight="3">patagonia\ground_snow3_pat</texture>
  </paint>
  <objects mode="turbulence" freq="0.35" octaves="3" persistence="0.70" emptyweight="50" posoffset="0.35">

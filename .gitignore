*.fbx
*.psd
*.tga
*.zip

# Local machine-specific documentation
docs/local_instructions.md

# Playground folder for testing (not committed to version control)
playground/
# Local machine configuration
config.local.md
__pycache__/
*.pyc
*.stackdump

# Editor-driver screenshots / census captures (scoped: only this dir, only png)
sandbox/census/*.png
# Backups live OUTSIDE the production folders, never beside working files.
# Whole tree ignored: nothing in here is source.
backups/

# AI landing-test harness: keep the CODE (driver/calibrate/probe/NAVIGATION),
# drop the per-run OUTPUT and anything calibrated to one machine.
#   runs/          archived Age3Log slices + AI output, ~1.4 MB per campaign
#   results.csv    one row per run, regenerated every campaign
#   whichsheet.json  selects the local device's coordinate sheet
#                    (sheets in coords/ are resolution-keyed and TRACKED)
scripts/aitest/runs/
scripts/aitest/last_lobby.png
scripts/aitest/results.csv
scripts/aitest/whichsheet.json
scripts/aitest/recording_tmp.mp4
scripts/aitest/STOP

# external reference clones at the repo root - never committed (skill references/ folders ARE tracked)
/references/

# local-only skill: converter harness bound to this PC (WSL+Wine paths)
/.claude/skills/gxo-convert/
/.agents/

# machine-specific converter backend (see scripts/havok/converter.example.json)
scripts/havok/converter.local.json

# Device-specific destinations for exporting/importing public skill repositories
config/skill-sync.local.json

# unit-bench screenshots are evidence, not repo content (8 MB each); saves + verdict JSON are tracked
sandbox/census/samples/bench/*.png

# London census results (saves, screenshots, verdict JSON) are evidence, not repo content
sandbox/census/samples/london/

# editor regeneration captures (politician dialog / editor / final screenshots) are evidence, not repo content
sandbox/census/samples/regen/

# Claude skills are tracked source; only device settings stay local
/.claude/settings.local.json

# Images (AGENTS.md hard rule 8): screenshots, captures, renders and plots made by agents never enter the repo.
# Ignored everywhere; re-included only in the image homes below (runtime art, UI icons, curated docs, skill assets).
*.png
*.jpg
*.jpeg
*.bmp
*.gif
*.webp

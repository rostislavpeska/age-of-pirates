{
 "schema": "blender-organic-uv/gates/1",
 "name": "TEMPLATE-unit-body",
 "date": null,
 "applies_to": "copy this file into the consuming game layer, name the unit class and page size, and fill every limit from measured reference units (references/gates.md, 'Deriving a profile'); a check without limits only reports",
 "derived_from": "fill: the reference units, their page sizes, the estimator rules, the pose and camera, the date and build",
 "runs": {
  "page": "uv_eval on every mesh of the page (body + skinned weapon), the attachment meshes as occluders",
  "body": "uv_eval on the body alone (weapon and attachments as occluders): the fair comparison with a reference body that owns its page"
 },
 "checks": [
  {"id": "flipped_faces", "label": "Flipped faces", "run": "page", "metric": "flips.flipped_faces", "hard": {"max": 0}, "target": {"max": 0}, "evidence": "no flipped face is acceptable"},
  {"id": "self_folds", "label": "Self-overlap (fold) px2", "run": "page", "metric": "overlaps.self_fold_px2", "hard": {"max": 0}, "target": {"max": 0}, "evidence": "no fold is acceptable"},
  {"id": "unintended_overlap", "label": "Unintended overlap px2", "run": "page", "metric": "overlaps.unintended_px2", "hard": {"max": 0}, "target": {"max": 0}, "evidence": "every mesh of one page together"},
  {"id": "mirrored_islands", "label": "Mirrored islands", "run": "page", "metric": "flips.mirrored_islands", "hard": {"max": 0}, "target": {"max": 0}, "evidence": "unique texels per side"},
  {"id": "declared_mirror", "label": "Stacked mirror texels px2", "run": "page", "metric": "overlaps.declared_mirror_px2", "hard": {"max": 0}, "target": {"max": 0}, "evidence": "unique texels per side"},
  {"id": "min_gap", "label": "Min island gap px", "run": "page", "metric": "packing.min_island_gap_px", "hard": null, "target": null, "evidence": "information until filled: the reference gutters"},
  {"id": "page_border", "label": "Page border px", "run": "page", "metric": "packing.min_page_border_px", "hard": null, "target": null, "evidence": "information until filled"},
  {"id": "L2", "label": "L2 stretch (page)", "run": "page", "metric": "distortion.L2_stretch", "hard": null, "target": null, "evidence": "information until filled"},
  {"id": "Linf", "label": "Linf stretch", "run": "page", "metric": "distortion.Linf_stretch", "hard": null, "target": null, "evidence": "information until filled"},
  {"id": "angle_mean", "label": "Angle stretch sigma1/sigma2 mean", "run": "page", "metric": "distortion.angular_aniso_mean", "hard": null, "target": null, "evidence": "information until filled"},
  {"id": "angle_p90", "label": "Angle stretch p90", "run": "page", "metric": "distortion.angular_aniso_p90", "hard": null, "target": null, "evidence": "information until filled"},
  {"id": "density_p50", "label": "Texel density p50 t/m", "run": "page", "metric": "texel_density.all.p50", "hard": null, "target": null, "evidence": "information until filled"},
  {"id": "density_visible_p10", "label": "Visible-weighted density p10 t/m", "run": "page", "metric": "texel_density.visible_weighted.p10", "hard": null, "target": null, "evidence": "information until filled"},
  {"id": "coverage", "label": "Texel coverage", "run": "page", "metric": "packing.coverage_texels", "hard": null, "target": null, "evidence": "information until filled"},
  {"id": "gpu_vertices", "label": "GPU vertices, every UV layer in file", "run": "page", "metric": "counts.gpu_vertices_all_uv_layers", "hard": null, "target": null, "evidence": "information until filled: the model contract's vertex ceiling"},
  {"id": "upright", "label": "Upright islands share", "run": "page", "metric": "orientation.upright_share_15deg", "hard": null, "target": null, "evidence": "information until filled"},
  {"id": "lr_asym", "label": "Left/right density asymmetry", "run": "page", "metric": "symmetry.density_log2_asym_mean", "hard": null, "target": null, "evidence": "information until filled"},
  {"id": "seam_per_sqrt_area", "label": "Body seam per sqrt(area)", "run": "body", "metric": "seams.seam_per_sqrt_area", "hard": null, "target": null, "evidence": "information until filled"},
  {"id": "visible_seam_per_sqrt_area", "label": "Visible seam per sqrt(area)", "run": "body", "metric": "seams.visible_mean_per_sqrt_area", "hard": null, "target": null, "evidence": "information until filled"},
  {"id": "uv_split_ratio", "label": "UV split ratio (body)", "run": "body", "metric": "counts.uv_split_ratio", "hard": null, "target": null, "evidence": "information until filled"},
  {"id": "body_islands", "label": "Body islands", "run": "body", "metric": "islands.count", "hard": null, "target": null, "evidence": "information until filled"},
  {"id": "body_tiny_islands", "label": "Body tiny islands", "run": "body", "metric": "islands.tiny_count", "hard": null, "target": null, "evidence": "information until filled"},
  {"id": "head_torso", "label": "Head/torso density (bone regions)", "run": "body", "metric": "bone_regions.head_torso", "hard": null, "target": null, "evidence": "information until filled: the project's head priority on the reference estimator"},
  {"id": "head_torso_visible", "label": "Head/torso, visible faces only", "run": "body", "metric": "bone_regions.head_torso_visible", "hard": null, "target": null, "evidence": "information: the same estimator without never-visible faces"}
 ]
}

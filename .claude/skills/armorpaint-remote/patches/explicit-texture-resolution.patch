 context_t *script_get_context() {
 	return g_context;
 }
+// Explicit square project resolution for headless scripting. The queued resize
+// must be followed by script-owned frames before save/export.
+bool script_set_texture_resolution(i32 size) {
+    if (size < 64 || size > 16384 || (size & (size - 1)) != 0) return false;
+    base_res = config_get_texture_res_pos(size);
+    base_res_x = (f32)size;
+    base_res_y = (f32)size;
+    layers_on_resized();
+    return true;
+}
+
 config_t *script_get_config() {
 	return g_config;
 }

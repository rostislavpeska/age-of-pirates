  "external": [
    {
      "id": "chrome",
      "kind": "executable",
      "commands": [
        "chrome",
        "google-chrome",
        "google-chrome-stable",
        "chromium",
        "chromium-browser"
      ],
      "requiredFor": [
        "headless"
      ],
      "optional": false,
      "note": "Chrome or Chromium, run only headless (--headless=new) with a throwaway profile under the cache; found through AOP_ANIM_VIEWER_BROWSER, the consumer's config/tool-paths.local.json (tools.chrome.path) or PATH. Never installed or updated by this skill.",
      "environment": "AOP_ANIM_VIEWER_BROWSER"
    },
    {
      "id": "edge",
      "kind": "executable",
      "commands": [
        "msedge",
        "microsoft-edge"
      ],
      "requiredFor": [
        "headless"
      ],
      "optional": true,
      "note": "Microsoft Edge, used only when named (--browser edge): on 2026-10-11 its launcher with a pending update opened a visible window on the owner's own profile (INC-237). Found through config/tool-paths.local.json (tools.edge.path) or PATH."
    },
    {
      "id": "node",
      "kind": "executable",
      "commands": [
        "node"
      ],
      "requiredFor": [
        "tests"
      ],
      "optional": true,
      "note": "Node 18 or newer runs tests/js/*.test.mjs with the built-in node --test (tests/test_viewer_js.py skips without it). No npm packages."
    },
    {
      "id": "blender",
      "kind": "executable",
      "commands": [
        "blender"
      ],
      "requiredFor": [
        "crosscheck"
      ],
      "optional": true,
      "note": "Background Blender (blender -b, no window) for the pose_sim side of scripts/crosscheck.py, through aoe3de-unit-animation's render_obj.py (tested 5.1); found through the consumer's config/tool-paths.local.json (tools.blender.path) or --blender. Without it the crosscheck renders the viewer side only."
    },
    {
      "id": "game-archives",
      "kind": "directory",
      "requiredFor": [
        "bundle"
      ],
      "optional": false,
      "note": "The retail AoE3 DE install read in place through aoe3de-bar-archives (never extracted into a repository); auto-detected, or AOE3DE_GAME.",
      "environment": "AOE3DE_GAME"
    },
    {
      "id": "numpy",
      "kind": "python-package",
      "requiredFor": [
        "bundle",
        "tests"
      ],
      "optional": false,
      "note": "Binary buffer views (av_common.BufferWriter, read_view) and the reference decoders in the tests.",
      "distribution": "numpy",
      "modules": [
        "numpy"
      ]
    },
    {
      "id": "pillow",
      "kind": "python-package",
      "requiredFor": [
        "crosscheck",
        "export",
        "tests"
      ],
      "optional": true,
      "note": "Reads the readback PNGs in the tests and composes the crosscheck sheet (scripts/crosscheck.py); the DDT PNG fallback goes through it too (ddt.py). M5: sheets (sheets.py), the video overlay and animated WebP (video.py).",
      "distribution": "pillow",
      "modules": [
        "PIL"
      ]
    },
    {
      "id": "pytest",
      "kind": "python-package",
      "requiredFor": [
        "tests"
      ],
      "optional": true,
      "note": "Runs tests/*.py; the consumer's local marker deselects the owner-machine cases in CI.",
      "distribution": "pytest",
      "modules": [
        "pytest"
      ]
    },
    {
      "id": "ffmpeg",
      "kind": "executable",
      "commands": [
        "ffmpeg"
      ],
      "requiredFor": [
        "video"
      ],
      "optional": true,
      "note": "MP4 encoding of anim_viewer.py video (libx264, yuv420p, +faststart; ffprobe beside it, when present, verifies the file). Found ONLY through the consumer's config/tool-paths.local.json (tools.ffmpeg.path) or --ffmpeg; never searched on PATH, installed or downloaded. Without it: a clear error, or --no-mp4 (frames and --webp only)."
    }
  ]

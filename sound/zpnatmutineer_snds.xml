<protounitsounddef>
  <!-- Age of Pirates Mutineer: three crews - Irish (0), British (1), Japanese Ronin (2) - keyed on the model variation of zp_mutineer.xml -->
  <protounit name="zpNatMutineer">
    <soundtype name="Select">
      <variationlogic>
        <choice name="0">
          <soundset name="IrishMilitarySelect" />
        </choice>
        <choice name="1">
          <soundset name="BritishGrenadierSelect" />
        </choice>
        <choice name="2">
          <soundset name="JapaneseRoninSelect" />
        </choice>
      </variationlogic>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="GenericMaleGrunt" />
    </soundtype>
    <soundtype name="Death">
      <soundset name="GenericMaleDeath" />
    </soundtype>
    <soundtype name="Creation">
      <soundset name="MilitaryBirth" />
    </soundtype>
    <soundtype name="Acknowledge">
      <targetlogic>
        <choice name="default">
          <variationlogic>
            <choice name="0">
              <soundset name="IrishMilitaryAcknowledge" />
            </choice>
            <choice name="1">
              <soundset name="BritishGrenadierAcknowledge" />
            </choice>
            <choice name="2">
              <soundset name="JapaneseRoninAcknowledge" />
            </choice>
          </variationlogic>
        </choice>
        <choice name="enemy">
          <variationlogic>
            <choice name="0">
              <soundset name="IrishMilitaryAttack" />
            </choice>
            <choice name="1">
              <soundset name="BritishGrenadierAttack" />
            </choice>
            <choice name="2">
              <soundset name="JapaneseRoninAttack" />
            </choice>
          </variationlogic>
        </choice>
        <choice name="build" />
        <choice name="Huntable" />
        <choice name="Tree">
          <variationlogic>
            <choice name="0">
              <soundset name="IrishMilitaryAcknowledge" />
            </choice>
            <choice name="1">
              <soundset name="BritishGrenadierAcknowledge" />
            </choice>
            <choice name="2">
              <soundset name="JapaneseRoninAcknowledge" />
            </choice>
          </variationlogic>
        </choice>
        <choice name="AbstractMine" />
        <choice name="AbstractFarm" />
        <choice name="AbstractResourceCrate" />
        <choice name="AbstractFruit" />
      </targetlogic>
    </soundtype>
  </protounit>
</protounitsounddef>
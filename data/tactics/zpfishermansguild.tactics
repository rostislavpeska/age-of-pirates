<tactics>
  <action>
    <name stringid="43294">AutoGatherCoin</name>
    <type>AutoGather</type>
    <active>1</active>
    <persistent>1</persistent>
    <autogatherteam>1</autogatherteam>
  </action>
  <action>
    <name stringid="43295">AutoGatherFood</name>
    <type>AutoGather</type>
    <active>1</active>
    <persistent>1</persistent>
    <autogatherteam>1</autogatherteam>
  </action>
  <action>
    <name stringid="303399">SpawnFishingBoat</name>
    <type>Maintain</type>
    <rate type="FishingBoat">1.0</rate>
    <maintaintrainpoints>50</maintaintrainpoints>
    <active>1</active>
    <persistent>1</persistent>
  </action>
  <action>
    <name>AutoConvert</name>
    <type>AutoConvert</type>
    <maxrange>20.0</maxrange>
    <persistent>1</persistent>
  </action>
  <tactic>ShrineFood<action>AutoGatherFood</action><action priority="25">AutoConvert</action><protounitcommand>zpTacticGuildFood</protounitcommand><transition><tactic>ShrineCoin</tactic><length>2</length><exit>1</exit></transition><transition><tactic>GuildFishingBoats</tactic><length>2</length><exit>1</exit></transition></tactic>
  <tactic>ShrineCoin<action>AutoGatherCoin</action><action priority="25">AutoConvert</action><protounitcommand>zpTacticGuildCoin</protounitcommand><transition><tactic>ShrineFood</tactic><length>2</length><exit>1</exit></transition><transition><tactic>GuildFishingBoats</tactic><length>2</length><exit>1</exit></transition></tactic>
  <tactic>GuildFishingBoats<action>SpawnFishingBoat</action><action priority="25">AutoConvert</action><protounitcommand>zpTacticSpawnFishingBoat</protounitcommand><transition><tactic>ShrineFood</tactic><length>2</length><exit>1</exit></transition><transition><tactic>ShrineCoin</tactic><length>2</length><exit>1</exit></transition></tactic>
</tactics>

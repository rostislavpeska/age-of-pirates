# This device's folders for Age of Pirates tooling. THIS REPO IS PUBLIC: no device path is ever written here.
# Copy to config/aop.local.env (gitignored) with `python scripts/tools/local_env.py --init`, fill it in there and check
# it with `python scripts/tools/local_env.py`. Find each folder on THIS device; never copy another device's value.
# Format: KEY=value on one line, no quotes, no spaces around '=', forward slashes (C:/Users/...). Read by Python tools
# and by the Git Bash hooks. A real environment variable of the same name takes precedence over this file.
# Empty = not on this device: the tools that need it skip or say so.

# Clone of github.com/rostislavpeska/korean-buildings-blender (UV lineage gate, gr2_to_raw.py for gr2_lint, recipe
# sources). Look for a git clone whose origin is that repository, e.g. under <home>/Documents/WORKSPACE or
# <home>/Desktop/WORKSPACE; keep it pulled (the gates live on its main branch).
AOP_KOREAN_REPO=

# The task engine folder (tasks.py, tasks.json, inbox, harness log; AGENTS.md rules 13 and 14):
# <AOP_KOREAN_REPO>/research/Texturing_11/Claude_CP2/tasks. Unset = no inbox and no P0 rule on this device; the harness
# then keeps its log, launch ledger and watch registry in <Claude config dir>/aop-tasks.
AOP_TASKS_DIR=

# The owner's "Korean Buildings Blender" asset folder (OneDrive; .blend sources, exports, references).
AOP_KOREAN_ASSETS=

# The aitest harness folder (gamectl.py, pw.py, minimap twin; aop_harness/aitest). Only some devices have it.
AOP_AITEST_DIR=

# Optional: the folder of gr2_lint's Korean TC test specimens (a session scratchpad holding p0_damaged/,
# install_rot_split/, ingame_fix/ and vanilla/m/). Unset = scripts/havok/tests/test_gr2_lint.py skips those tests.
GR2_LINT_SPECIMENS=

# gr2_lint dll_read route (the Granny DLL export gate, AGENTS.md rule 13): wsl (default: Wine in WSL, set up by the
# gxo-convert installer), native (the same tool and DLL directly on Windows; refused while Smart App Control is on) or
# both (each must pass with byte-identical output). Not a path.
AOP_GR2_DLL_ROUTE=

# The WSL distro that has Wine, ~/.wine_gxo and ~/gxo/granny2_age3de.dll (`wsl -l -v` names it, e.g. Ubuntu or
# Ubuntu-24.04). Unset = gr2_to_raw.py's default 'Ubuntu'. Not a path.
AOP_WSL_DISTRO=

# The converter's granny2_age3de.dll on Windows, next to GXOConverterAge3DE.exe (usually the OneDrive "DE Converter"
# folder). Needed by the native and both routes only.
AOP_GR2_DLL=

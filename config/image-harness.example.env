# Image harness (Claude-only, .claude/skills/image-harness). THIS REPO IS PUBLIC.
# Copy to config/image-harness.local.env (gitignored) and fill in there - never here.
# Real environment variables of the same names take precedence over the file.
IMAGE_HARNESS_URL=https://<n8n host>/webhook/<path>
IMAGE_HARNESS_KEY=<x-api-key value from the n8n workflow>
